<Window x:Class="WPFTemplate.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="500" Width="800">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Список пользователей" Margin="0,0,10,0" Grid.Column="0">
            <DataGrid ItemsSource="{Binding Users}" 
                      SelectedItem="{Binding SelectedUser}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Header="Управление" Grid.Column="1">
            <StackPanel Margin="10">
                <TextBlock Text="ФИО:" FontWeight="Bold"/>
                <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Height="25"/>

                <TextBlock Text="Логин:" FontWeight="Bold"/>
                <TextBox Text="{Binding FormLogin, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Height="25"/>

                <TextBlock Text="Пароль:" FontWeight="Bold"/>
                <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Height="25"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" 
                           Margin="0,5,0,15" FontWeight="Bold" HorizontalAlignment="Center"/>

                <Button Content="Очистить форму / Снять выбор" Command="{Binding ClearFormCommand}" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Добавить" Command="{Binding AddCommand}"/>
                    <Button Grid.Column="1" Content="Сохранить" Command="{Binding EditCommand}"/>
                </Grid>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>