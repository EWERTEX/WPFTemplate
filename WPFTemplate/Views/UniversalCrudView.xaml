<UserControl x:Class="WPFTemplate.Views.UniversalCrudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Быстрый поиск:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox Width="300" Height="25" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding ItemsView}" 
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="True" 
                  AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                  CanUserAddRows="True" 
                  CanUserDeleteRows="True">
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Удалить выбранное" Command="{Binding DeleteCommand}" Background="#E74C3C" Margin="0,0,10,0"/>
            <Button Content="Сохранить изменения" Command="{Binding SaveChangesCommand}" Background="#2ECC71"/>
        </StackPanel>
    </Grid>
</UserControl>